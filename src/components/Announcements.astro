---
import annoData from '../../public/api/v1/anno.json'
import { marked } from 'marked'

const announcements = annoData.announcements
const rendered = announcements.map(a => marked.parse(a.content) as string)
---

<div class="anno-wrap">
  <nav class="anno-nav">
    {announcements.map((a, i) => (
      <button class:list={["anno-btn", { active: i === 0 }]} data-i={i}>
        {a.title}
      </button>
    ))}
  </nav>
  <div class="anno-body">
    {rendered.map((html, i) => (
      <article class:list={["anno-article", { active: i === 0 }]} data-i={i} set:html={html} />
    ))}
  </div>
</div>

<script>
  function setup() {
    document.querySelectorAll<HTMLElement>('.anno-wrap').forEach(wrap => {
      const btns = wrap.querySelectorAll<HTMLButtonElement>('.anno-btn');
      const articles = wrap.querySelectorAll<HTMLElement>('.anno-article');
      wrap.querySelector('.anno-nav')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('.anno-btn') as HTMLButtonElement;
        if (!btn) return;
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        articles.forEach(a => a.classList.toggle('active', a.dataset.i === btn.dataset.i));
      });
    });
  }
  setup();
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .anno-wrap {
    display: flex;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    overflow: hidden;
    max-height: 80vh;
  }

  /* ── 左侧导航 ── */
  .anno-nav {
    width: 260px;
    min-width: 260px;
    overflow-y: auto;
    border-right: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-nav);
  }

  .anno-btn {
    margin: 0;
    display: block;
    width: 100%;
    padding: 0.7rem 1rem;
    border: none;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    text-align: left;
    cursor: pointer;
    transition: background .15s, color .15s;
  }
  .anno-btn:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .anno-btn.active {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }

  /* ── 右侧内容 ── */
  .anno-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    margin: 0;
  }

  .anno-article { display: none; }
  .anno-article.active { display: block; }

  /* Markdown 排版 */
  .anno-article :global(h1) { font-size: 1.6rem; margin: 0 0 .8rem; }
  .anno-article :global(h2) { font-size: 1.3rem; margin: 1.2rem 0 .6rem; }
  .anno-article :global(h3) { font-size: 1.1rem; margin: 1rem 0 .5rem; }
  .anno-article :global(h4) { font-size: 1rem;   margin: .8rem 0 .4rem; }

  .anno-article :global(p) {
    margin: 0 0 .6rem;
    line-height: 1.75;
  }

  .anno-article :global(ul),
  .anno-article :global(ol) {
    margin: .4rem 0 .8rem;
    padding-left: 1.5rem;
  }
  .anno-article :global(li) { margin-bottom: .25rem; }

  .anno-article :global(strong) { color: var(--sl-color-white); }

  .anno-article :global(code) {
    background: var(--sl-color-gray-6);
    padding: .15em .4em;
    border-radius: 4px;
    font-size: .875em;
  }
  .anno-article :global(pre) {
    background: var(--sl-color-gray-6);
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: .6rem 0;
  }
  .anno-article :global(pre code) { background: transparent; padding: 0; }

  .anno-article :global(blockquote) {
    border-left: 3px solid var(--sl-color-accent);
    margin: .6rem 0;
    padding: .4rem 1rem;
    color: var(--sl-color-gray-3);
  }

  .anno-article :global(hr) {
    border: none;
    border-top: 1px solid var(--sl-color-gray-5);
    margin: 1rem 0;
  }

  /* ── 移动端 ── */
  @media (max-width: 640px) {
    .anno-wrap { flex-direction: column; }
    .anno-nav {
      width: 100%;
      min-width: unset;
      max-height: 180px;
      border-right: none;
      border-bottom: 1px solid var(--sl-color-gray-5);
    }
  }
</style>
